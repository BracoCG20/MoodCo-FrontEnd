---
import casesData from '../../data/cases.json';
import CaseCard from './CaseCard.astro';
import './Cases.scss';

const imageFiles = import.meta.glob<{ default: { src: string } }>(
  '../../assets/cases/*.{png,jpg,jpeg,webp}',
  { eager: true },
);

const getImagePath = (filename: string) => {
  const path = `../../assets/cases/${filename}`;
  const image = imageFiles[path];
  return image ? image.default.src : '';
};

// Generamos desfases
const col1 = [...casesData.items];
const col2 = [...casesData.items.slice(2), ...casesData.items.slice(0, 2)];
const col3 = [...casesData.items.slice(4), ...casesData.items.slice(0, 4)];

// Duplicamos para loop infinito
const track1 = [...col1, ...col1];
const track2 = [...col2, ...col2];
const track3 = [...col3, ...col3];
---

<section
  class='cases'
  aria-labelledby='cases-title'
  data-animate-section
>
  <header
    class='cases__header'
    data-animate-element
  >
    <h2
      id='cases-title'
      class='cases__heading'
    >
      <span class='cases__heading-regular'>{casesData.header.regular}</span>
      <br />
      <span class='cases__heading-bold'>{casesData.header.bold}</span>
    </h2>
  </header>

  <div class='cases__carousel-wrapper'>
    <div class='cases__columns'>
      <!-- Columna 1 (Mobile / Tablet / Desktop) -->
      <div
        class='cases__col cases__col--1'
        data-col-index='0'
      >
        <div
          class='cases__track'
          data-carousel-track
        >
          {
            track1.map((item) => (
              <CaseCard
                title={item.title}
                description={item.description}
                tags={item.tags}
                link={item.link}
                imageSrc={getImagePath(item.image)}
                video={(item as any).video ?? ''}
              />
            ))
          }
        </div>
      </div>

      <!-- Columna 2 (Tablet / Desktop) -->
      <div
        class='cases__col cases__col--2'
        data-col-index='1'
      >
        <div
          class='cases__track'
          data-carousel-track
        >
          {
            track2.map((item) => (
              <CaseCard
                title={item.title}
                description={item.description}
                tags={item.tags}
                link={item.link}
                imageSrc={getImagePath(item.image)}
                video={(item as any).video ?? ''}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Modal Global de Video (reutilizado por todas las cards) -->
<div
  class='video-modal'
  data-video-modal
  aria-hidden='true'
  role='dialog'
  aria-modal='true'
  aria-labelledby='modal-title'
>
  <div
    class='video-modal__backdrop'
    data-modal-backdrop
  >
  </div>
  <div
    class='video-modal__container'
    data-modal-container
  >
    <div class='video-modal__header'>
      <span
        class='video-modal__title'
        id='modal-title'
        data-modal-title
      ></span>
      <button
        class='video-modal__close'
        data-modal-close
        aria-label='Cerrar modal'
        type='button'
        >cerrar ×</button
      >
    </div>

    <div class='video-modal__media'>
      <video
        class='video-modal__video'
        data-modal-video
        playsinline
        preload='metadata'
      ></video>

      <!-- Botón play/pausa personalizado -->
      <button
        class='video-modal__play-btn'
        data-modal-play
        aria-label='Reproducir / Pausar'
        type='button'
      >
        <svg
          class='video-modal__play-icon'
          data-play-icon
          viewBox='0 0 24 24'
          fill='currentColor'
        >
          <path d='M8 5v14l11-7z'></path>
        </svg>
        <svg
          class='video-modal__pause-icon'
          data-pause-icon
          viewBox='0 0 24 24'
          fill='currentColor'
          style='display:none'
        >
          <path d='M6 19h4V5H6v14zm8-14v14h4V5h-4z'></path>
        </svg>
      </button>

      <!-- Barra de progreso personalizada -->
      <div
        class='video-modal__progress'
        data-modal-progress
      >
        <div
          class='video-modal__progress-track'
          data-progress-track
        >
          <div
            class='video-modal__progress-fill'
            data-progress-fill
          >
          </div>
          <div
            class='video-modal__progress-knob'
            data-progress-knob
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const tracks = document.querySelectorAll('[data-carousel-track]');
    const carouselWrapper = document.querySelector('.cases__carousel-wrapper');
    const cards = document.querySelectorAll('[data-case-card]');
    const col1 = document.querySelector('.cases__col--1') as HTMLElement;
    const track1 = col1?.querySelector('.cases__track') as HTMLElement;

    const isHoverable = window.matchMedia('(hover: hover)').matches;
    const isTouch = window.matchMedia(
      '(hover: none), (pointer: coarse)',
    ).matches;

    let carousels: gsap.core.Tween[] = [];
    let activeCard: HTMLElement | null = null;
    let isCardActive = false;
    let isTouching = false;
    let autoScrollReq: number;
    let touchStartY = 0;
    let touchStartScrollTop = 0;
    let touchMode: 'idle' | 'carousel' | 'page' = 'idle';
    let pageScrollStartY = 0;
    let pageScrollStartTop = 0;
    const SWIPE_THRESHOLD = 6;

    const isMobileViewport = () =>
      window.matchMedia('(max-width: 1023px)').matches;
    const mod = (n: number, m: number) => ((n % m) + m) % m;

    let mm = gsap.matchMedia();

    // =========================================================
    // LÓGICA RESPONSIVE (Aísla Mobile de Desktop dinámicamente)
    // =========================================================
    mm.add(
      {
        isMobile: '(max-width: 1023px)',
        isDesktop: '(min-width: 1024px)',
      },
      (context) => {
        let { isMobile, isDesktop } = context.conditions as any;

        // Limpieza preventiva
        if (autoScrollReq) cancelAnimationFrame(autoScrollReq);
        carousels.forEach((c) => c.kill());
        carousels = [];
        gsap.set(col1, { clearProps: 'overflowY,overflowX' });

        // LÓGICA DESKTOP (Mantiene el loop intacto de GSAP)
        if (isDesktop) {
          carousels = Array.from(tracks).map((track, index) => {
            const isMovingUp = index % 2 !== 0;
            return gsap.fromTo(
              track,
              { yPercent: isMovingUp ? 0 : -50 },
              {
                yPercent: isMovingUp ? -50 : 0,
                duration: 40,
                ease: 'none',
                repeat: -1,
              },
            );
          });
        }

        // LÓGICA MOBILE/TABLET (Permite scroll nativo + chaining)
        if (isMobile && col1 && track1) {
          // Habilita el scroll vertical nativo
          gsap.set(col1, { overflowY: 'auto', overflowX: 'hidden' });

          const resetPosition = () => {
            if (col1 && track1) col1.scrollTop = track1.scrollHeight / 2;
          };
          setTimeout(resetPosition, 100);

          // Bucle de auto-scroll suave
          const tick = () => {
            if (!isTouching && !isCardActive) {
              col1.scrollTop -= 0.5; // Baja visualmente
              if (col1.scrollTop <= 0) {
                col1.scrollTop = track1.scrollHeight / 2;
              }
            }
            autoScrollReq = requestAnimationFrame(tick);
          };
          tick();

          // Cuando la sección desaparece de la pantalla, resetea el loop nativo
          ScrollTrigger.create({
            trigger: '.cases',
            start: 'top bottom',
            end: 'bottom top',
            onLeave: resetPosition,
            onLeaveBack: resetPosition,
          });
        }
      },
    );

    // =========================================================
    // SWIPE MANUAL EN MOBILE (respeta límites reales de casos)
    // =========================================================
    if (col1 && track1) {
      col1.addEventListener(
        'touchstart',
        (e) => {
          if (!isMobileViewport()) return;
          isTouching = true; // pausa el auto-scroll (tick)
          touchMode = 'idle';
          touchStartY = e.touches[0].clientY;
          touchStartScrollTop = col1.scrollTop;
        },
        { passive: true },
      );

      col1.addEventListener(
        'touchmove',
        (e) => {
          if (!isMobileViewport()) return;

          const currentY = e.touches[0].clientY;
          const deltaY = touchStartY - currentY; // swipe arriba = deltaY positivo

          // Micro-movimiento: aún podría ser un tap sobre una card -> no interferir
          if (touchMode === 'idle' && Math.abs(deltaY) < SWIPE_THRESHOLD)
            return;
          if (touchMode === 'idle') touchMode = 'carousel';

          if (touchMode === 'carousel') {
            const singleLoopHeight = track1.scrollHeight / 2; // altura real (sin duplicar)
            const realStart = mod(touchStartScrollTop, singleLoopHeight);
            const tentativeReal = realStart + deltaY;

            // Límite real alcanzado (primer o último caso) -> liberar a scroll de página
            if (tentativeReal <= 0 || tentativeReal >= singleLoopHeight) {
              col1.scrollTop =
                tentativeReal <= 0
                  ? touchStartScrollTop - realStart
                  : touchStartScrollTop + (singleLoopHeight - realStart);

              touchMode = 'page';
              pageScrollStartY = currentY;
              pageScrollStartTop = window.scrollY;
              e.preventDefault(); // evita doble manejo del mismo gesto
              return;
            }

            e.preventDefault();
            col1.scrollTop = touchStartScrollTop + deltaY;
            return;
          }

          // touchMode === 'page': el carrusel ya llegó a su límite, ahora mueve la página
          e.preventDefault();
          const pageDelta = pageScrollStartY - currentY;
          window.scrollTo(0, pageScrollStartTop + pageDelta);
        },
        { passive: false },
      );

      col1.addEventListener(
        'touchend',
        () => {
          isTouching = false; // reanuda el loop automático (tick)
          touchMode = 'idle';
        },
        { passive: true },
      );
    }

    // =========================================================
    // EVENTOS DE INTERACCIÓN DE CARDS
    // =========================================================
    cards.forEach((card) => {
      const track = card.closest('[data-carousel-track]') as HTMLElement;
      const col = card.closest('[data-col-index]');
      const colIndex = col
        ? parseInt(col.getAttribute('data-col-index') || '-1', 10)
        : -1;

      const trigger = card.querySelector(
        '[data-case-trigger]',
      ) as HTMLButtonElement;
      const body = card.querySelector('[data-case-body]') as HTMLElement;
      const img = card.querySelector('[data-case-img]') as HTMLElement;
      const overlay = card.querySelector('[data-case-overlay]') as HTMLElement;

      gsap.set(body, { height: 0, overflow: 'hidden' });

      // HOVER (Solo interrumpe en Desktop)
      if (isHoverable) {
        card.addEventListener('mouseenter', () => {
          const isDesktop = window.innerWidth >= 1024;
          if (isDesktop && colIndex >= 0 && colIndex < carousels.length) {
            carousels[colIndex].pause();
          }

          if (card.classList.contains('is-active')) return;

          gsap.to(img, { scale: 1.2, duration: 0.4, ease: 'power2.out' });
          gsap.to(overlay, { opacity: 0.6, duration: 0.4, ease: 'power2.out' });
        });

        card.addEventListener('mouseleave', () => {
          const isDesktop = window.innerWidth >= 1024;

          if (card.classList.contains('is-active')) {
            gsap.to(body, { height: 0, duration: 0.4, ease: 'power2.inOut' });
            trigger.setAttribute('aria-expanded', 'false');
            card.classList.remove('is-active');
            activeCard = null;
            isCardActive = false;

            if (isDesktop) {
              gsap.to(track, {
                y: 0,
                duration: 0.4,
                ease: 'power2.inOut',
                onComplete: () => {
                  if (
                    window.innerWidth >= 1024 &&
                    colIndex >= 0 &&
                    colIndex < carousels.length
                  ) {
                    carousels[colIndex].play();
                  }
                },
              });
            }
          } else {
            if (isDesktop && colIndex >= 0 && colIndex < carousels.length) {
              carousels[colIndex].play();
            }
          }

          gsap.to(img, { scale: 1, duration: 0.4, ease: 'power2.out' });
          gsap.to(overlay, { opacity: 0, duration: 0.4, ease: 'power2.out' });
        });
      }

      // CLICK (Abre card y controla GSAP o Native Scroll según viewport)
      trigger.addEventListener('click', (e) => {
        if (isTouch) e.stopPropagation();

        const isDesktop = window.innerWidth >= 1024;
        const isCurrentlyActive = activeCard === card;

        // Cierra una card activa diferente
        if (isTouch && activeCard && !isCurrentlyActive) {
          const activeBody = activeCard.querySelector('[data-case-body]');
          const activeTrigger = activeCard.querySelector('[data-case-trigger]');
          const activeTrack = activeCard.closest('[data-carousel-track]');
          const activeCol = activeCard.closest('[data-col-index]');
          const activeColIndex = activeCol
            ? parseInt(activeCol.getAttribute('data-col-index') || '-1', 10)
            : -1;

          gsap.to(activeBody, {
            height: 0,
            duration: 0.4,
            ease: 'power2.inOut',
          });
          activeTrigger?.setAttribute('aria-expanded', 'false');
          activeCard.classList.remove('is-active');

          if (isDesktop && activeTrack) {
            gsap.to(activeTrack, {
              y: 0,
              duration: 0.4,
              ease: 'power2.inOut',
              onComplete: () => {
                if (activeColIndex >= 0 && activeColIndex < carousels.length)
                  carousels[activeColIndex].play();
              },
            });
          }
        }

        // Cierra la card actual si le volvemos a dar click
        if (isCurrentlyActive) {
          gsap.to(body, { height: 0, duration: 0.4, ease: 'power2.inOut' });
          trigger.setAttribute('aria-expanded', 'false');
          card.classList.remove('is-active');
          activeCard = null;
          isCardActive = false;

          if (isDesktop) {
            gsap.to(track, {
              y: 0,
              duration: 0.4,
              ease: 'power2.inOut',
              onComplete: () => {
                if (isTouch && colIndex >= 0 && colIndex < carousels.length) {
                  carousels[colIndex].play();
                }
              },
            });
          }
        }
        // Abre una nueva card
        else {
          if (
            isDesktop &&
            isTouch &&
            colIndex >= 0 &&
            colIndex < carousels.length
          ) {
            carousels[colIndex].pause();
          }

          gsap.to(body, {
            height: 'auto',
            duration: 0.4,
            ease: 'power2.inOut',
          });
          trigger.setAttribute('aria-expanded', 'true');
          card.classList.add('is-active');
          activeCard = card as HTMLElement;
          isCardActive = true; // Pausa el auto-scroll de requestAnimationFrame en Mobile

          // Centrado dinámico en Desktop
          if (isDesktop && carouselWrapper) {
            const wrapperRect = carouselWrapper.getBoundingClientRect();
            const cardRect = card.getBoundingClientRect();

            const wrapperCenter = wrapperRect.top + wrapperRect.height / 2;
            const expandedCardCenter =
              cardRect.top + cardRect.height / 2 + body.scrollHeight / 2;

            const shiftY = wrapperCenter - expandedCardCenter;
            gsap.to(track, {
              y: `+=${shiftY}`,
              duration: 0.4,
              ease: 'power2.inOut',
            });
          }

          gsap.to(img, { scale: 1, duration: 0.4, ease: 'power2.out' });
          gsap.to(overlay, { opacity: 0, duration: 0.4, ease: 'power2.out' });
        }
      });
    });

    // =========================================================
    // LÓGICA DEL MODAL DE VIDEO
    // =========================================================
    const DEMO_VIDEO =
      'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4';

    const videoModal = document.querySelector(
      '[data-video-modal]',
    ) as HTMLElement;
    const modalBackdrop = document.querySelector(
      '[data-modal-backdrop]',
    ) as HTMLElement;
    const modalContainer = document.querySelector(
      '[data-modal-container]',
    ) as HTMLElement;
    const modalTitleEl = document.querySelector(
      '[data-modal-title]',
    ) as HTMLElement;
    const modalVideo = document.querySelector(
      '[data-modal-video]',
    ) as HTMLVideoElement;
    const modalClose = document.querySelector(
      '[data-modal-close]',
    ) as HTMLButtonElement;
    const modalPlayBtn = document.querySelector(
      '[data-modal-play]',
    ) as HTMLButtonElement;
    const playIcon = document.querySelector('[data-play-icon]') as SVGElement;
    const pauseIcon = document.querySelector('[data-pause-icon]') as SVGElement;
    const progressFill = document.querySelector(
      '[data-progress-fill]',
    ) as HTMLElement;
    const progressKnob = document.querySelector(
      '[data-progress-knob]',
    ) as HTMLElement;
    const progressTrack = document.querySelector(
      '[data-progress-track]',
    ) as HTMLElement;

    if (!videoModal || !modalVideo) return;

    let isModalOpen = false;
    let isDragging = false;

    // ----- Helpers -----
    const updatePlayIcons = (paused: boolean) => {
      if (paused) {
        playIcon.style.display = 'block';
        pauseIcon.style.display = 'none';
      } else {
        playIcon.style.display = 'none';
        pauseIcon.style.display = 'block';
      }
    };

    const updateProgress = () => {
      if (!modalVideo.duration) return;
      const pct = (modalVideo.currentTime / modalVideo.duration) * 100;
      gsap.set(progressFill, { width: `${pct}%` });
      gsap.set(progressKnob, { left: `${pct}%` });
    };

    const seekFromEvent = (e: MouseEvent | Touch) => {
      const rect = progressTrack.getBoundingClientRect();
      const clientX = 'clientX' in e ? e.clientX : (e as Touch).clientX;
      const ratio = Math.min(
        Math.max((clientX - rect.left) / rect.width, 0),
        1,
      );
      modalVideo.currentTime = ratio * modalVideo.duration;
      updateProgress();
    };

    // ----- Abrir modal -----
    const openModal = (title: string, videoSrc: string) => {
      isModalOpen = true;
      modalTitleEl.textContent = title;
      modalVideo.src = videoSrc || DEMO_VIDEO;
      modalVideo.load();
      modalVideo.pause();
      updatePlayIcons(true);
      gsap.set(progressFill, { width: '0%' });
      gsap.set(progressKnob, { left: '0%' });

      videoModal.setAttribute('aria-hidden', 'false');
      videoModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';

      gsap.fromTo(
        modalBackdrop,
        { opacity: 0 },
        { opacity: 1, duration: 0.35, ease: 'power2.out' },
      );
      gsap.fromTo(
        modalContainer,
        { opacity: 0, scale: 0.85, y: 30 },
        {
          opacity: 1,
          scale: 1,
          y: 0,
          duration: 0.45,
          ease: 'back.out(1.4)',
          delay: 0.05,
        },
      );
    };

    // ----- Cerrar modal -----
    const closeModal = () => {
      if (!isModalOpen) return;

      gsap.to(modalContainer, {
        opacity: 0,
        scale: 0.9,
        y: 20,
        duration: 0.3,
        ease: 'power2.in',
      });
      gsap.to(modalBackdrop, {
        opacity: 0,
        duration: 0.3,
        ease: 'power2.in',
        onComplete: () => {
          isModalOpen = false;
          videoModal.setAttribute('aria-hidden', 'true');
          videoModal.style.display = 'none';
          modalVideo.pause();
          modalVideo.src = '';
          document.body.style.overflow = '';
          updatePlayIcons(true);
        },
      });
    };

    // ----- Delegación de eventos: abrir modal -----
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest(
        '[data-ver-caso]',
      ) as HTMLElement | null;
      if (!btn) return;
      e.stopPropagation();
      const title = btn.getAttribute('data-title') ?? '';
      const videoSrc = btn.getAttribute('data-video') ?? '';
      openModal(title, videoSrc);
    });

    // ----- Cerrar: botón X -----
    modalClose.addEventListener('click', closeModal);

    // ----- Cerrar: click en backdrop -----
    modalBackdrop.addEventListener('click', closeModal);

    // ----- Cerrar: tecla Escape -----
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isModalOpen) closeModal();
    });

    // ----- Play / Pausa -----
    modalPlayBtn.addEventListener('click', () => {
      if (modalVideo.paused) {
        modalVideo.play();
        updatePlayIcons(false);
        // Ocultar botón play después de iniciar
        gsap.fromTo(
          modalPlayBtn,
          { opacity: 1, scale: 1 },
          {
            opacity: 0,
            scale: 0.8,
            duration: 0.4,
            ease: 'power2.in',
            delay: 0.6,
          },
        );
      } else {
        modalVideo.pause();
        updatePlayIcons(true);
        gsap.fromTo(
          modalPlayBtn,
          { opacity: 0, scale: 0.8 },
          { opacity: 1, scale: 1, duration: 0.3, ease: 'back.out(1.4)' },
        );
      }
    });

    // Click en el video: toggle play/pausa con animación del botón
    modalVideo.addEventListener('click', () => {
      if (modalVideo.paused) {
        modalVideo.play();
        updatePlayIcons(false);
        gsap.fromTo(
          modalPlayBtn,
          { opacity: 1, scale: 1.2 },
          {
            opacity: 0,
            scale: 0.8,
            duration: 0.5,
            ease: 'power2.in',
            delay: 0.5,
          },
        );
      } else {
        modalVideo.pause();
        updatePlayIcons(true);
        gsap.fromTo(
          modalPlayBtn,
          { opacity: 0, scale: 0.8 },
          { opacity: 1, scale: 1, duration: 0.3, ease: 'back.out(1.4)' },
        );
      }
    });

    // Mostrar botón play cuando el video termina
    modalVideo.addEventListener('ended', () => {
      updatePlayIcons(true);
      gsap.fromTo(
        modalPlayBtn,
        { opacity: 0, scale: 0.8 },
        { opacity: 1, scale: 1, duration: 0.3, ease: 'back.out(1.4)' },
      );
    });

    // ----- Progreso en tiempo real -----
    modalVideo.addEventListener('timeupdate', updateProgress);

    // ----- Seek: click en barra -----
    progressTrack.addEventListener('click', (e) => {
      seekFromEvent(e);
    });

    // ----- Seek: drag en barra -----
    progressTrack.addEventListener('mousedown', (e) => {
      isDragging = true;
      seekFromEvent(e);
    });
    document.addEventListener('mousemove', (e) => {
      if (isDragging) seekFromEvent(e);
    });
    document.addEventListener('mouseup', () => {
      isDragging = false;
    });

    // Touch seek
    progressTrack.addEventListener('touchstart', (e) => {
      isDragging = true;
      seekFromEvent(e.touches[0]);
    });
    document.addEventListener('touchmove', (e) => {
      if (isDragging) seekFromEvent(e.touches[0]);
    });
    document.addEventListener('touchend', () => {
      isDragging = false;
    });
  });
</script>
