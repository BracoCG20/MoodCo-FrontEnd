---
import casesData from '../../data/cases.json';
import CaseCard from './CaseCard.astro';
import './Cases.scss';

const imageFiles = import.meta.glob<{ default: { src: string } }>(
  '../../assets/cases/*.{png,jpg,jpeg,webp}',
  { eager: true },
);

const getImagePath = (filename: string) => {
  const path = `../../assets/cases/${filename}`;
  const image = imageFiles[path];
  return image ? image.default.src : '';
};

// Generamos desfases para que las columnas no se vean exactamente iguales lado a lado
const col1 = [...casesData.items];
const col2 = [...casesData.items.slice(2), ...casesData.items.slice(0, 2)];
const col3 = [...casesData.items.slice(4), ...casesData.items.slice(0, 4)];

// Duplicamos cada array para poder crear el loop infinito fluido
const track1 = [...col1, ...col1];
const track2 = [...col2, ...col2];
const track3 = [...col3, ...col3];
---

<section
  class='cases'
  aria-labelledby='cases-title'
>
  <header class='cases__header'>
    <h2
      id='cases-title'
      class='cases__heading'
    >
      <span class='cases__heading-regular'>{casesData.header.regular}</span>
      <br />
      <span class='cases__heading-bold'>{casesData.header.bold}</span>
    </h2>
  </header>

  <div class='cases__carousel-wrapper'>
    <div class='cases__columns'>
      <!-- Columna 1 (Índice 0: Hacia abajo) -->
      <div
        class='cases__col cases__col--1'
        data-col-index='0'
      >
        <div
          class='cases__track'
          data-carousel-track
        >
          {
            track1.map((item) => (
              <CaseCard
                title={item.title}
                description={item.description}
                tags={item.tags}
                link={item.link}
                imageSrc={getImagePath(item.image)}
              />
            ))
          }
        </div>
      </div>

      <!-- Columna 2 (Índice 1: Hacia arriba | Visible desde Tablet) -->
      <div
        class='cases__col cases__col--2'
        data-col-index='1'
      >
        <div
          class='cases__track'
          data-carousel-track
        >
          {
            track2.map((item) => (
              <CaseCard
                title={item.title}
                description={item.description}
                tags={item.tags}
                link={item.link}
                imageSrc={getImagePath(item.image)}
              />
            ))
          }
        </div>
      </div>

      <!-- Columna 3 (Índice 2: Hacia abajo | Visible desde Desktop) -->
      <div
        class='cases__col cases__col--3'
        data-col-index='2'
      >
        <div
          class='cases__track'
          data-carousel-track
        >
          {
            track3.map((item) => (
              <CaseCard
                title={item.title}
                description={item.description}
                tags={item.tags}
                link={item.link}
                imageSrc={getImagePath(item.image)}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Lógica del Carrusel Infinito Alternado
    const tracks = document.querySelectorAll('[data-carousel-track]');

    const carousels = Array.from(tracks).map((track, index) => {
      const isMovingUp = index % 2 !== 0;

      if (isMovingUp) {
        // Movimiento hacia ARRIBA
        return gsap.fromTo(
          track,
          { yPercent: 0 },
          { yPercent: -50, duration: 40, ease: 'none', repeat: -1 },
        );
      } else {
        // Movimiento hacia ABAJO
        return gsap.fromTo(
          track,
          { yPercent: -50 },
          { yPercent: 0, duration: 40, ease: 'none', repeat: -1 },
        );
      }
    });

    const carouselWrapper = document.querySelector('.cases__carousel-wrapper');
    const isHoverable = window.matchMedia('(hover: hover)').matches;
    const isTouch = window.matchMedia(
      '(hover: none), (pointer: coarse)',
    ).matches;

    // 2. Lógica de las Cards (Hover y Activo controlan su propia columna)
    const cards = document.querySelectorAll('[data-case-card]');
    let activeCard: HTMLElement | null = null;

    // Animación de Entrada por Scroll
    gsap.from(cards, {
      scrollTrigger: {
        trigger: '.cases__columns',
        start: 'top 80%',
      },
      opacity: 0,
      scale: 0.95,
      filter: 'blur(10px)',
      duration: 0.8,
      stagger: 0.1,
      ease: 'power3.out',
      clearProps: 'all',
    });

    cards.forEach((card) => {
      const track = card.closest('[data-carousel-track]') as HTMLElement;
      const col = card.closest('[data-col-index]');
      const colIndex = col
        ? parseInt(col.getAttribute('data-col-index') || '-1', 10)
        : -1;

      const trigger = card.querySelector(
        '[data-case-trigger]',
      ) as HTMLButtonElement;
      const body = card.querySelector('[data-case-body]') as HTMLElement;
      const img = card.querySelector('[data-case-img]') as HTMLElement;
      const overlay = card.querySelector('[data-case-overlay]') as HTMLElement;

      gsap.set(body, { height: 0, overflow: 'hidden' });

      // HOVER: Detiene ÚNICAMENTE la columna a la que pertenece
      if (isHoverable) {
        card.addEventListener('mouseenter', () => {
          if (colIndex !== -1 && carousels[colIndex]) {
            carousels[colIndex].pause();
          }

          if (card.classList.contains('is-active')) return;

          // Visual hover
          gsap.to(img, { scale: 1.2, duration: 0.4, ease: 'power2.out' });
          gsap.to(overlay, { opacity: 0.6, duration: 0.4, ease: 'power2.out' });
        });

        card.addEventListener('mouseleave', () => {
          // Si está activa, la cerramos automáticamente al retirar el mouse
          if (card.classList.contains('is-active')) {
            gsap.to(body, { height: 0, duration: 0.4, ease: 'power2.inOut' });
            trigger.setAttribute('aria-expanded', 'false');
            card.classList.remove('is-active');
            activeCard = null;

            // Retiramos el ajuste de centrado y reanudamos la animación
            gsap.to(track, {
              y: 0,
              duration: 0.4,
              ease: 'power2.inOut',
              onComplete: () => {
                if (colIndex !== -1 && carousels[colIndex]) {
                  carousels[colIndex].play();
                }
              },
            });
          } else {
            // Si no estaba activa, simplemente reanudamos
            if (colIndex !== -1 && carousels[colIndex]) {
              carousels[colIndex].play();
            }
          }

          // Revertir visual hover
          gsap.to(img, { scale: 1, duration: 0.4, ease: 'power2.out' });
          gsap.to(overlay, { opacity: 0, duration: 0.4, ease: 'power2.out' });
        });
      }

      // CLICK: Abre y centra la card
      trigger.addEventListener('click', (e) => {
        if (isTouch) e.stopPropagation();

        const isCurrentlyActive = activeCard === card;

        // Si es táctil y hay otra activa, la cerramos (en Desktop esto se maneja con mouseleave)
        if (isTouch && activeCard && !isCurrentlyActive) {
          const activeBody = activeCard.querySelector('[data-case-body]');
          const activeTrigger = activeCard.querySelector('[data-case-trigger]');
          const activeTrack = activeCard.closest('[data-carousel-track]');
          const activeCol = activeCard.closest('[data-col-index]');
          const activeColIndex = activeCol
            ? parseInt(activeCol.getAttribute('data-col-index') || '-1', 10)
            : -1;

          gsap.to(activeBody, {
            height: 0,
            duration: 0.4,
            ease: 'power2.inOut',
          });
          activeTrigger?.setAttribute('aria-expanded', 'false');
          activeCard.classList.remove('is-active');

          gsap.to(activeTrack, {
            y: 0,
            duration: 0.4,
            ease: 'power2.inOut',
            onComplete: () => {
              if (activeColIndex !== -1 && carousels[activeColIndex])
                carousels[activeColIndex].play();
            },
          });
        }

        if (isCurrentlyActive) {
          // Cierra la card actual si se vuelve a hacer click
          gsap.to(body, { height: 0, duration: 0.4, ease: 'power2.inOut' });
          trigger.setAttribute('aria-expanded', 'false');
          card.classList.remove('is-active');
          activeCard = null;

          gsap.to(track, {
            y: 0,
            duration: 0.4,
            ease: 'power2.inOut',
            onComplete: () => {
              if (isTouch && colIndex !== -1 && carousels[colIndex]) {
                carousels[colIndex].play();
              }
            },
          });
        } else {
          // Abre la card
          if (isTouch && colIndex !== -1 && carousels[colIndex]) {
            carousels[colIndex].pause(); // Asegura pausa en táctil
          }

          gsap.to(body, {
            height: 'auto',
            duration: 0.4,
            ease: 'power2.inOut',
          });
          trigger.setAttribute('aria-expanded', 'true');
          card.classList.add('is-active');
          activeCard = card as HTMLElement;

          // Cálculo para centrar dinámicamente la card en la columna
          if (carouselWrapper) {
            const wrapperRect = carouselWrapper.getBoundingClientRect();
            const cardRect = card.getBoundingClientRect();

            const wrapperCenter = wrapperRect.top + wrapperRect.height / 2;
            // El centro final considera el alto que tomará el body al expandirse
            const expandedCardCenter =
              cardRect.top + cardRect.height / 2 + body.scrollHeight / 2;

            const shiftY = wrapperCenter - expandedCardCenter;
            gsap.to(track, {
              y: `+=${shiftY}`,
              duration: 0.4,
              ease: 'power2.inOut',
            });
          }

          // Limpia el visual hover al abrirse
          gsap.to(img, { scale: 1, duration: 0.4, ease: 'power2.out' });
          gsap.to(overlay, { opacity: 0, duration: 0.4, ease: 'power2.out' });
        }
      });
    });
  });
</script>
