---
import headerData from '../../data/header.json';
import './Header.scss';
---

<header
  class='header'
  data-header
>
  <div class='header__container'>
    <!-- Logo -->
    <a
      href='/'
      class='header__brand'
      aria-label='Volver al inicio'
    >
      <img
        src='/logo_header.png'
        alt='Mood'
        class='header__logo'
      />
    </a>

    <!-- Lema -->
    <p class='header__tagline'>{headerData.tagline}</p>

    <!-- Botón Hamburger -->
    <button
      class='header__toggle'
      data-menu-toggle
      aria-label='Abrir menú'
      aria-expanded='false'
    >
      <svg
        xmlns='http://www.w3.org/2000/svg'
        width='1em'
        height='1em'
        viewBox='0 0 24 24'
        class='header__icon'
        data-menu-icon
      >
        <path
          d='M0 0h24v24H0z'
          fill='none'
        ></path>
        <path
          fill='none'
          stroke='currentColor'
          stroke-linecap='round'
          stroke-linejoin='round'
          stroke-width='1.5'
          d='M4 8.5h16m-16 7h16'
        ></path>
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable -->
  <nav
    class='header__menu'
    data-menu
    aria-hidden='true'
  >
    <div class='header__menu-inner'>
      <!-- Enlaces de navegación -->
      <ul class='header__nav'>
        {
          headerData.links.map((link) => (
            <li
              class='header__nav-item'
              data-nav-item
            >
              <a
                href={link.url}
                class='header__nav-link'
                data-nav-link
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Selector de Idioma -->
      <div
        class='header__lang'
        data-lang-selector
      >
        <!-- Elemento de fondo: Burbuja líquida -->
        <div
          class='header__lang-bubble'
          data-lang-bubble
        >
        </div>

        {
          headerData.languages.map((lang) => (
            <button
              class={`header__lang-btn ${lang.active ? 'is-active' : ''}`}
              data-lang-btn
            >
              {lang.label}
            </button>
          ))
        }
      </div>
    </div>
  </nav>
</header>

<script>
  import gsap from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('[data-header]') as HTMLElement;
    const toggleBtn = document.querySelector(
      '[data-menu-toggle]',
    ) as HTMLButtonElement;
    const menuIcon = document.querySelector('[data-menu-icon]') as HTMLElement;
    const menu = document.querySelector('[data-menu]') as HTMLElement;
    const navItems = document.querySelectorAll('[data-nav-item]');
    const navLinks = document.querySelectorAll('[data-nav-link]');

    // Elementos del selector de idioma
    const langSelector = document.querySelector('[data-lang-selector]');
    const langBtns = document.querySelectorAll('[data-lang-btn]');
    const bubble = document.querySelector('[data-lang-bubble]') as HTMLElement;

    let isMenuOpen = false;

    // 1. Configuración inicial de GSAP para el menú
    gsap.set(menu, { autoAlpha: 0, clipPath: 'inset(0 0 100% 0)' });
    gsap.set(navItems, { y: 30, opacity: 0 });
    gsap.set(langSelector, { y: 20, opacity: 0 });

    // 2. Timeline del Menú
    const menuTl = gsap.timeline({
      paused: true,
      defaults: { ease: 'power3.inOut' },
    });

    menuTl
      .to(menu, { autoAlpha: 1, clipPath: 'inset(0 0 0% 0)', duration: 0.6 })
      .to(
        navItems,
        { y: 0, opacity: 1, duration: 0.5, stagger: 0.05, ease: 'power2.out' },
        '-=0.3',
      )
      .to(
        langSelector,
        { y: 0, opacity: 1, duration: 0.5, ease: 'power2.out' },
        '-=0.4',
      );

    // 3. Lógica del Botón Toggle
    const toggleMenu = () => {
      isMenuOpen = !isMenuOpen;
      toggleBtn.setAttribute('aria-expanded', isMenuOpen.toString());

      if (isMenuOpen) {
        menuTl.play();
        header.classList.add('is-open');
        gsap.to(menuIcon, {
          rotation: 90,
          scale: 0.8,
          duration: 0.4,
          ease: 'power2.inOut',
        });
        document.body.style.overflow = 'hidden';
      } else {
        menuTl.reverse();
        header.classList.remove('is-open');
        gsap.to(menuIcon, {
          rotation: 0,
          scale: 1,
          duration: 0.4,
          ease: 'power2.inOut',
        });
        document.body.style.overflow = '';
      }
    };

    toggleBtn.addEventListener('click', toggleMenu);

    // 4. Microinteracciones (Navegación)
    navLinks.forEach((link) => {
      link.addEventListener('mouseenter', () => {
        gsap.to(link, {
          x: 10,
          color: '#99ff99',
          duration: 0.3,
          ease: 'power2.out',
        });
      });
      link.addEventListener('mouseleave', () => {
        gsap.to(link, {
          x: 0,
          color: '#FFFFFF',
          duration: 0.3,
          ease: 'power2.out',
        });
      });

      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          toggleMenu();
        } else {
          e.preventDefault();
          gsap.to(navLinks, {
            opacity: 0,
            x: -20,
            duration: 0.3,
            stagger: 0.02,
          });
          setTimeout(() => {
            window.location.href = href || '/';
          }, 400);
        }
      });
    });

    // 5. Animación líquida (Viscosa) del Selector de Idioma
    // Inicializar posición de la burbuja
    const initBubble = () => {
      const activeBtn = Array.from(langBtns).find((btn) =>
        btn.classList.contains('is-active'),
      ) as HTMLElement;
      if (activeBtn && bubble) {
        gsap.set(bubble, {
          left: activeBtn.offsetLeft,
          width: activeBtn.offsetWidth,
        });
      }
    };

    // Reposicionar al cambiar tamaño de pantalla para evitar desajustes
    window.addEventListener('resize', initBubble);
    // Posición inicial
    setTimeout(initBubble, 50);

    langBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('is-active')) return;

        // Quitar la clase a los botones inactivos y animar solo el color del texto
        langBtns.forEach((b) => {
          b.classList.remove('is-active');
          gsap.to(b, { color: '#FFFFFF', duration: 0.3 });
        });

        // Activar el seleccionado
        btn.classList.add('is-active');
        gsap.to(btn, { color: '#000000', duration: 0.3, ease: 'power2.out' });

        // LÓGICA DE LA BURBUJA LÍQUIDA
        if (bubble) {
          const htmlBtn = btn as HTMLElement;
          const targetLeft = htmlBtn.offsetLeft;
          const targetWidth = htmlBtn.offsetWidth;

          // Leemos posición actual desde GSAP
          const currentLeft = gsap.getProperty(bubble, 'left') as number;
          const isMovingRight = targetLeft > currentLeft;

          // Matamos animaciones previas para evitar colisiones si se clica rápido
          gsap.killTweensOf(bubble);
          const tl = gsap.timeline();

          // Efecto de fusión y estiramiento viscoso
          if (isMovingRight) {
            // Se estira hacia la derecha primero y se "aplasta" (scaleY)
            tl.to(bubble, {
              width: targetLeft + targetWidth - currentLeft,
              scaleY: 0.7,
              borderRadius: '16px',
              duration: 0.2,
              ease: 'power2.in',
            }).to(bubble, {
              left: targetLeft,
              width: targetWidth,
              scaleY: 1,
              borderRadius: '8px', // Vuelve a su forma natural
              duration: 0.45,
              ease: 'elastic.out(1, 0.7)', // Rebote elástico del líquido
            });
          } else {
            // Se estira hacia la izquierda
            tl.to(bubble, {
              left: targetLeft,
              width:
                ((currentLeft + gsap.getProperty(bubble, 'width')) as number) -
                targetLeft,
              scaleY: 0.7,
              borderRadius: '16px',
              duration: 0.2,
              ease: 'power2.in',
            }).to(bubble, {
              width: targetWidth,
              scaleY: 1,
              borderRadius: '8px',
              duration: 0.45,
              ease: 'elastic.out(1, 0.7)',
            });
          }
        }
      });
    });
  });
</script>
