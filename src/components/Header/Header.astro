---
import headerData from '../../data/header.json';
import './Header.scss';
---

<header class="header" data-header>
  <div class="header__container">
    
    <!-- Logo -->
    <a href="/" class="header__brand" aria-label="Volver al inicio">
      <!-- Utilizamos la imagen de logo existente -->
      <img src="/logo_header.png" alt="Mood" class="header__logo" />
    </a>

    <!-- Lema (Oculto en mobile, visible en desktop) -->
    <p class="header__tagline">{headerData.tagline}</p>

    <!-- Botón Hamburger (SVG Exacto requerido) -->
    <button class="header__toggle" data-menu-toggle aria-label="Abrir menú" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" class="header__icon" data-menu-icon>
        <path d="M0 0h24v24H0z" fill="none" />
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8.5h16m-16 7h16" />
      </svg>
    </button>
    
  </div>

  <!-- Menú Desplegable (Overlay) -->
  <nav class="header__menu" data-menu aria-hidden="true">
    <div class="header__menu-inner">
      
      <!-- Enlaces de navegación -->
      <ul class="header__nav">
        {headerData.links.map((link) => (
          <li class="header__nav-item" data-nav-item>
            <a href={link.url} class="header__nav-link" data-nav-link>{link.label}</a>
          </li>
        ))}
      </ul>

      <!-- Selector de Idioma (Trasladado al interior del menú) -->
      <div class="header__lang" data-lang-selector>
        {headerData.languages.map((lang) => (
          <button 
            class={`header__lang-btn ${lang.active ? 'is-active' : ''}`} 
            data-lang-btn
          >
            {lang.label}
          </button>
        ))}
      </div>

    </div>
  </nav>
</header>

<script>
  import gsap from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('[data-header]') as HTMLElement;
    const toggleBtn = document.querySelector('[data-menu-toggle]') as HTMLButtonElement;
    const menuIcon = document.querySelector('[data-menu-icon]') as HTMLElement;
    const menu = document.querySelector('[data-menu]') as HTMLElement;
    const navItems = document.querySelectorAll('[data-nav-item]');
    const navLinks = document.querySelectorAll('[data-nav-link]');
    const langSelector = document.querySelector('[data-lang-selector]');
    const langBtns = document.querySelectorAll('[data-lang-btn]');
    
    let isMenuOpen = false;

    // 1. Configuración inicial de GSAP para el menú
    gsap.set(menu, { autoAlpha: 0, clipPath: 'inset(0 0 100% 0)' });
    gsap.set(navItems, { y: 30, opacity: 0 });
    gsap.set(langSelector, { y: 20, opacity: 0 });

    // 2. Timeline del Menú (Apertura y Cierre)
    const menuTl = gsap.timeline({ paused: true, defaults: { ease: "power3.inOut" } });

    menuTl
      .to(menu, { 
        autoAlpha: 1, 
        clipPath: 'inset(0 0 0% 0)', 
        duration: 0.6 
      })
      .to(navItems, { 
        y: 0, 
        opacity: 1, 
        duration: 0.5, 
        stagger: 0.05,
        ease: "power2.out"
      }, "-=0.3")
      .to(langSelector, { 
        y: 0, 
        opacity: 1, 
        duration: 0.5,
        ease: "power2.out"
      }, "-=0.4");

    // 3. Lógica del Botón Toggle
    const toggleMenu = () => {
      isMenuOpen = !isMenuOpen;
      toggleBtn.setAttribute('aria-expanded', isMenuOpen.toString());

      if (isMenuOpen) {
        // Animación de apertura
        menuTl.play();
        header.classList.add('is-open');
        // Animación fluida del icono SVG (Rotación elegante ya que no podemos alterar los paths)
        gsap.to(menuIcon, { rotation: 90, scale: 0.8, duration: 0.4, ease: "power2.inOut" });
        document.body.style.overflow = 'hidden'; // Evitar scroll
      } else {
        // Animación de cierre
        menuTl.reverse();
        header.classList.remove('is-open');
        gsap.to(menuIcon, { rotation: 0, scale: 1, duration: 0.4, ease: "power2.inOut" });
        document.body.style.overflow = ''; 
      }
    };

    toggleBtn.addEventListener('click', toggleMenu);

    // 4. Microinteracciones de los enlaces de navegación (Hover y Click)
    navLinks.forEach(link => {
      // Hover interactivo
      link.addEventListener('mouseenter', () => {
        gsap.to(link, { x: 10, color: '#A8F48F', duration: 0.3, ease: "power2.out" });
      });
      link.addEventListener('mouseleave', () => {
        gsap.to(link, { x: 0, color: '#FFFFFF', duration: 0.3, ease: "power2.out" });
      });

      // Transición al clickear antes de navegar
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          toggleMenu(); // Si es un ancla interna, solo cerramos el menú
        } else {
          e.preventDefault();
          gsap.to(navLinks, { opacity: 0, x: -20, duration: 0.3, stagger: 0.02 });
          setTimeout(() => {
            window.location.href = href || '/';
          }, 400);
        }
      });
    });

    // 5. Animación interactiva del Selector de Idioma
    langBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('is-active')) return;

        // Quitar estado activo al anterior
        langBtns.forEach(b => {
          b.classList.remove('is-active');
          gsap.to(b, { backgroundColor: 'transparent', color: '#FFFFFF', duration: 0.3 });
        });

        // Activar el seleccionado (Estilo píldora como en la referencia)
        btn.classList.add('is-active');
        gsap.to(btn, { backgroundColor: '#FFFFFF', color: '#000000', duration: 0.3, ease: "power2.out" });
        
        // Efecto sutil de "click"
        gsap.fromTo(btn, { scale: 0.9 }, { scale: 1, duration: 0.3, ease: "back.out(1.5)" });
      });
    });
  });
</script>