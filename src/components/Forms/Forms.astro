---
import formsData from '../../data/forms.json';
import './Forms.scss';
---

<section
  class='forms-section'
  id='contacto'
>
  <!-- ============================================== -->
  <!-- FORMULARIO 1: CONTACTO                         -->
  <!-- ============================================== -->
  <div
    class='forms-section__wrapper is-active'
    id='wrapper-contacto'
  >
    <div class='forms-section__content'>
      <header class='forms-section__header'>
        <h2 class='forms-section__title'>
          <span class='forms-section__title-regular'
            >{formsData.formContacto.title.regular}</span
          >
          <span class='forms-section__title-bold'
            >{formsData.formContacto.title.bold}</span
          >
        </h2>
        <p class='forms-section__subtitle'>{formsData.formContacto.subtitle}</p>
      </header>

      <form
        class='form'
        id='form-contacto'
        novalidate
      >
        <!-- CAMPOS OCULTOS DE SEGURIDAD E IDENTIFICACIÓN -->
        <input
          type='hidden'
          name='formType'
          value='contacto'
        />
        <!-- Honeypot: Se agrega aria-hidden para que los lectores de pantalla lo ignoren y no afecte accesibilidad -->
        <input
          type='text'
          name='bot_check'
          style='display: none;'
          tabindex='-1'
          autocomplete='off'
          aria-hidden='true'
        />

        {
          formsData.formContacto.fields.map((field) => (
            <div class='form__group'>
              <label
                for={field.id}
                class='form__label'
              >
                {field.label}
              </label>
              <input
                type={field.type as any}
                id={field.id}
                name={field.name}
                class='form__input'
                required
              />
              <span
                class='form__error'
                data-error-for={field.id}
              />
            </div>
          ))
        }

        <div class='form__actions'>
          <button
            type='submit'
            class='form__btn form__btn--submit'
            data-btn='submit'
          >
            {formsData.formContacto.buttons.submit}
          </button>
          <button
            type='button'
            class='form__btn form__btn--success is-hidden'
            data-btn='success'
          >
            {formsData.formContacto.buttons.success}
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2.5'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <circle
                data-check-circle
                cx='12'
                cy='12'
                r='10'
              ></circle>
              <path
                data-check-path
                d='M8 12l3 3 6-6'
              ></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================== -->
  <!-- FORMULARIO 2: TRABAJA CON NOSOTROS             -->
  <!-- ============================================== -->
  <div
    class='forms-section__wrapper'
    id='wrapper-trabaja'
  >
    <div class='forms-section__content'>
      <header class='forms-section__header'>
        <h2 class='forms-section__title'>
          <span class='forms-section__title-bold'
            >{formsData.formTrabajo.title.bold}</span
          >
          <span class='forms-section__title-regular'
            >{formsData.formTrabajo.title.regular}</span
          >
          <span class='forms-section__title-bold'
            >{formsData.formTrabajo.title.bold2}</span
          >
        </h2>
        <p class='forms-section__subtitle'>{formsData.formTrabajo.subtitle}</p>
      </header>

      <form
        class='form'
        id='form-trabaja-con-nosotros'
        novalidate
      >
        <input
          type='hidden'
          name='formType'
          value='trabaja'
        />
        <input
          type='text'
          name='bot_check'
          style='display: none;'
          tabindex='-1'
          autocomplete='off'
          aria-hidden='true'
        />

        {
          formsData.formTrabajo.fields.map((field) => (
            <div class='form__group'>
              <label
                for={field.id}
                class='form__label'
              >
                {field.label}
              </label>
              <input
                type={field.type as any}
                id={field.id}
                name={field.name}
                class='form__input'
                required
              />
              <span
                class='form__error'
                data-error-for={field.id}
              />
            </div>
          ))
        }

        <div class='form__group form__group--file'>
          <label
            for='t-archivo'
            class='form__label form__label--file'
          >
            {formsData.formTrabajo.uploadLabel}
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
            >
              <path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'></path>
              <polyline points='17 8 12 3 7 8'></polyline>
              <line
                x1='12'
                y1='3'
                x2='12'
                y2='15'
              ></line>
            </svg>
          </label>
          <input
            type='file'
            id='t-archivo'
            name='archivo'
            class='form__input-file'
            accept='.pdf,.doc,.docx'
            required
          />
          <span
            class='form__error'
            data-error-for='t-archivo'
          ></span>
        </div>

        <div class='form__actions'>
          <button
            type='submit'
            class='form__btn form__btn--submit'
            data-btn='submit'
          >
            {formsData.formTrabajo.buttons.submit}
          </button>
          <button
            type='button'
            class='form__btn form__btn--success is-hidden'
            data-btn='success'
          >
            {formsData.formTrabajo.buttons.success}
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2.5'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <circle
                data-check-circle
                cx='12'
                cy='12'
                r='10'
              ></circle>
              <path
                data-check-path
                d='M8 12l3 3 6-6'
              ></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const triggerButtons = document.querySelectorAll('[data-form-trigger]');
    const wrapperContacto = document.getElementById('wrapper-contacto');
    const wrapperTrabaja = document.getElementById('wrapper-trabaja');

    triggerButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const target = btn.getAttribute('data-form-trigger');

        if (target === 'trabaja') {
          wrapperContacto?.classList.remove('is-active');
          wrapperTrabaja?.classList.add('is-active');
        } else {
          wrapperTrabaja?.classList.remove('is-active');
          wrapperContacto?.classList.add('is-active');
        }
        document
          .getElementById('contacto')
          ?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    // 1. FUNCIÓN DE VALIDACIÓN ESTRICTA FRONTEND
    const validateForm = (formElement: HTMLFormElement): boolean => {
      let isValid = true;
      const inputs = formElement.querySelectorAll(
        'input:not([type="hidden"]):not([type="file"])',
      );
      const fileInput = formElement.querySelector(
        'input[type="file"]',
      ) as HTMLInputElement;

      // Limpiamos errores previos
      formElement
        .querySelectorAll('.is-invalid')
        .forEach((el) => el.classList.remove('is-invalid'));
      formElement
        .querySelectorAll('.form__error')
        .forEach((el) => (el.textContent = ''));

      inputs.forEach((input) => {
        const inputEl = input as HTMLInputElement;
        const name = inputEl.name;
        const value = inputEl.value.trim();
        const errorEl = formElement.querySelector(
          `[data-error-for="${inputEl.id}"]`,
        );
        let errorMessage = '';

        if (inputEl.required && !value) {
          errorMessage = 'Este campo es obligatorio.';
        } else if (value) {
          if (name === 'nombre') {
            if (!/^[a-zA-ZÀ-ÿ\u00f1\u00d1\s]+$/.test(value)) {
              errorMessage = 'Solo se permiten letras y espacios.';
            } else if (value.length < 2 || value.length > 50) {
              errorMessage = 'Debe tener entre 2 y 50 caracteres.';
            }
          } else if (name === 'correo') {
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
              errorMessage = 'Por favor, ingresa un correo válido.';
            }
          } else if (name === 'telefono') {
            if (!/^\+?[\d\s\-]{6,20}$/.test(value)) {
              errorMessage = 'Solo números, espacios y +. (6-20 caracteres).';
            }
          } else if (name === 'mensaje') {
            if (value.length > 2000) {
              errorMessage = 'El mensaje no puede exceder 2000 caracteres.';
            }
          }
        }

        if (errorMessage) {
          inputEl.classList.add('is-invalid');
          if (errorEl) {
            errorEl.textContent = errorMessage;
            gsap.fromTo(
              errorEl,
              { opacity: 0, y: -5 },
              { opacity: 1, y: 0, duration: 0.3 },
            );
          }
          isValid = false;
        }
      });

      // Validar archivo si existe en el form
      if (fileInput && fileInput.required) {
        const errorEl = formElement.querySelector(
          `[data-error-for="${fileInput.id}"]`,
        );
        const file = fileInput.files?.[0];
        let errorMessage = '';

        if (!file) {
          errorMessage = 'Debes adjuntar un archivo (CV).';
        } else {
          const validTypes = [
            'application/pdf',
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          ];
          if (!validTypes.includes(file.type)) {
            errorMessage = 'Solo se aceptan archivos PDF, DOC o DOCX.';
          } else if (file.size > 5 * 1024 * 1024) {
            errorMessage = 'El archivo supera los 5MB permitidos.';
          }
        }

        if (errorMessage) {
          if (errorEl) {
            errorEl.textContent = errorMessage;
            gsap.fromTo(
              errorEl,
              { opacity: 0, y: -5 },
              { opacity: 1, y: 0, duration: 0.3 },
            );
          }
          isValid = false;
        }
      }

      return isValid;
    };

    const forms = document.querySelectorAll('.form');

    forms.forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formElement = form as HTMLFormElement;

        // Validamos el frontend antes de enviar nada
        if (!validateForm(formElement)) return;

        const submitBtn = formElement.querySelector(
          '[data-btn="submit"]',
        ) as HTMLButtonElement;
        const successBtn = formElement.querySelector(
          '[data-btn="success"]',
        ) as HTMLButtonElement;
        const circlePath = successBtn?.querySelector('[data-check-circle]');
        const checkPath = successBtn?.querySelector('[data-check-path]');

        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'ENVIANDO...';
        submitBtn.disabled = true;

        const loadingTween = gsap.to(submitBtn, {
          opacity: 0.6,
          repeat: -1,
          yoyo: true,
          duration: 0.4,
          ease: 'power1.inOut',
        });

        try {
          const formData = new FormData(formElement);

          const response = await fetch('/api/forms/submit', {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();

          if (!response.ok || !result.success) {
            throw new Error(result.message || 'Error en el servidor');
          }

          loadingTween.kill();
          gsap.set(submitBtn, { opacity: 1 });

          submitBtn.classList.add('is-hidden');
          successBtn.classList.remove('is-hidden');

          gsap.fromTo(
            successBtn,
            { opacity: 0, scale: 0.95 },
            { opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(1.5)' },
          );

          if (circlePath && checkPath) {
            gsap.fromTo(
              circlePath,
              { strokeDasharray: 65, strokeDashoffset: 65 },
              {
                strokeDashoffset: 0,
                duration: 0.5,
                ease: 'power2.out',
                delay: 0.1,
              },
            );
            gsap.fromTo(
              checkPath,
              { strokeDasharray: 20, strokeDashoffset: 20 },
              {
                strokeDashoffset: 0,
                duration: 0.4,
                ease: 'power2.out',
                delay: 0.4,
              },
            );
          }

          formElement.reset();
          formElement
            .querySelectorAll('.is-invalid')
            .forEach((el) => el.classList.remove('is-invalid'));
          formElement
            .querySelectorAll('.form__error')
            .forEach((el) => (el.textContent = ''));

          setTimeout(() => {
            gsap.to(successBtn, {
              opacity: 0,
              scale: 0.95,
              duration: 0.3,
              onComplete: () => {
                successBtn.classList.add('is-hidden');
                submitBtn.classList.remove('is-hidden');
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
                gsap.fromTo(
                  submitBtn,
                  { opacity: 0 },
                  { opacity: 1, duration: 0.3 },
                );
              },
            });
          }, 4000);
        } catch (error: any) {
          loadingTween.kill();
          gsap.set(submitBtn, { opacity: 1 });
          submitBtn.textContent = error.message || 'ERROR. REINTENTAR';
          submitBtn.disabled = false;
          setTimeout(() => {
            submitBtn.textContent = originalText;
          }, 3000);
        }
      });
    });
  });
</script>
