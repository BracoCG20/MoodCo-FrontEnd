---
import timelineData from '../../data/timeline.json';
import TimelineItem from './TimelineItem.astro';
import './Timeline.scss';
---

<section
  class='timeline'
  id='timeline'
>
  <!-- ======================================================= -->
  <!-- VERSIÓN MOBILE / TABLET (< 1024px)                      -->
  <!-- ======================================================= -->
  <div class='timeline__mobile-only'>
    <div class='timeline-mobile__sticky-scene'>
      <div class='timeline__grid-bg'></div>
      <div class='timeline__grid-bg2'></div>
      <div
        class='timeline-mobile__intro-texts'
        data-intro-text='mobile'
      >
        <p
          class='timeline-mobile__intro-text timeline-mobile__intro-text--top'
          set:html={timelineData.intro.topText}
        />
        <p
          class='timeline-mobile__intro-text timeline-mobile__intro-text--bottom'
          set:html={timelineData.intro.bottomText}
        />
      </div>

      <div
        class='timeline-mobile__mood-letters'
        data-mood-block='mobile'
      >
        <img
          src='/timeline/M.webp'
          alt='M'
          class='timeline-mobile__letter'
        />
        <img
          src='/timeline/O.webp'
          alt='O'
          class='timeline-mobile__letter'
        />
        <img
          src='/timeline/O.webp'
          alt='O'
          class='timeline-mobile__letter'
        />
        <img
          src='/timeline/D.webp'
          alt='D'
          class='timeline-mobile__letter'
        />
      </div>

      <div class='timeline-mobile__figures'>
        <img
          src='/timeline/figura_1.webp'
          alt=''
          class='timeline-mobile__figure timeline-mobile__figure--1'
          data-figure='mobile'
        />
        <img
          src='/timeline/figura_2.webp'
          alt=''
          class='timeline-mobile__figure timeline-mobile__figure--2'
          data-figure='mobile'
        />
        <img
          src='/timeline/figura_3.webp'
          alt=''
          class='timeline-mobile__figure timeline-mobile__figure--3'
          data-figure='mobile'
        />
      </div>

      <img
        src='/timeline/letra_timeline.webp'
        alt="What's your"
        class='timeline-mobile__whats-your'
      />
    </div>

    <div class='timeline-mobile__scroll-track'>

      <div class='timeline-mobile__content'>
        <div class='timeline-mobile__center-line'>
          <div
            class='timeline-mobile__center-line-progress'
            data-line-progress='mobile'
          >
          </div>
        </div>

        <div class='timeline-mobile__items'>
          {
            timelineData.items.map((item, index) => (
              <TimelineItem
                number={item.number}
                title={item.title}
                description={item.description}
                align={index % 2 === 0 ? 'left' : 'right'}
                context='mobile'
              />
            ))
          }
        </div>
      </div>

      <div
        class='timeline-mobile__spacer'
        data-outro-spacer='mobile'
      >
      </div>
    </div>
  </div>

  <!-- ======================================================= -->
  <!-- VERSIÓN DESKTOP (>= 1024px)                             -->
  <!-- ======================================================= -->
  <div class='timeline__desktop-only'>
    <div class='timeline-desktop__sticky-scene'>
      <div class='timeline__grid-bg'></div>
      <div class='timeline__grid-bg2'></div>
      <div
        class='timeline-desktop__intro-texts'
        data-intro-text='desktop'
      >
        <p
          class='timeline-desktop__intro-text timeline-desktop__intro-text--top'
          set:html={timelineData.intro.topText}
        />
        <p
          class='timeline-desktop__intro-text timeline-desktop__intro-text--bottom'
          set:html={timelineData.intro.bottomText}
        />
      </div>

      <div
        class='timeline-desktop__mood-letters'
        data-mood-block='desktop'
      >
        <img
          src='/timeline/M.webp'
          alt='M'
          class='timeline-desktop__letter'
        />
        <img
          src='/timeline/O.webp'
          alt='O'
          class='timeline-desktop__letter'
        />
        <img
          src='/timeline/O.webp'
          alt='O'
          class='timeline-desktop__letter'
        />
        <img
          src='/timeline/D.webp'
          alt='D'
          class='timeline-desktop__letter'
        />
      </div>

      <div class='timeline-desktop__figures'>
        <img
          src='/timeline/figura_1.webp'
          alt=''
          class='timeline-desktop__figure timeline-desktop__figure--1'
          data-figure='desktop'
        />
        <img
          src='/timeline/figura_2.webp'
          alt=''
          class='timeline-desktop__figure timeline-desktop__figure--2'
          data-figure='desktop'
        />
        <img
          src='/timeline/figura_3.webp'
          alt=''
          class='timeline-desktop__figure timeline-desktop__figure--3'
          data-figure='desktop'
        />
      </div>

      <img
        src='/timeline/letra_timeline2.webp'
        alt="What's your"
        class='timeline-desktop__whats-your'
      />
    </div>

    <div class='timeline-desktop__scroll-track'>
      <div class='timeline-desktop__spacer'></div>

      <div class='timeline-desktop__content'>
        <div class='timeline-desktop__items'>
          <div class='timeline-desktop__center-line'>
            <div
              class='timeline-desktop__center-line-progress'
              data-line-progress='desktop'
            >
            </div>
          </div>

          {
            timelineData.items.map((item, index) => (
              <TimelineItem
                number={item.number}
                title={item.title}
                description={item.description}
                align={index % 2 === 0 ? 'left' : 'right'}
                context='desktop'
              />
            ))
          }
        </div>
      </div>

      <div
        class='timeline-desktop__spacer'
        data-outro-spacer='desktop'
      >
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let currentMM: gsap.MatchMedia | null = null;

  function initTimelineAnimations() {
    // Limpieza defensiva: evita duplicar ScrollTriggers si este script
    // se re-ejecuta (ej. navegación con Astro View Transitions)
    ScrollTrigger.getAll().forEach((st) => {
      if (typeof st.vars.id === 'string' && st.vars.id.startsWith('timeline-')) {
        st.kill();
      }
    });
    currentMM?.revert();

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    const mm = gsap.matchMedia();
    currentMM = mm;

    // =======================================================
    // CONTEXTO MOBILE / TABLET (< 1024px)
    // =======================================================
    mm.add('(max-width: 1023px)', () => {
      const items = gsap.utils.toArray<HTMLElement>(
        '[data-timeline-item="mobile"]',
      );
      const lineProgress = document.querySelector('[data-line-progress="mobile"]');

      // Respeta accesibilidad: sin movimiento, todo visible de inmediato
      if (prefersReducedMotion) {
        gsap.set(lineProgress, { scaleY: 1 });
        items.forEach((item) => {
          gsap.set(item.querySelector('.timeline-item__content-wrapper'), {
            opacity: 1,
            y: 0,
            scale: 1,
          });
          gsap.set(item.querySelector('[data-circuit-node]'), { scale: 1 });
        });
        return;
      }

      // --- Intro: MUCHO más corta y sin lag (antes: +=150vh, scrub 2) ---
      const introTl = gsap.timeline({
        scrollTrigger: {
          id: 'timeline-mobile-intro',
          trigger: '.timeline__mobile-only',
          start: 'top top',
          end: '+=70vh',
          scrub: 0.6, // antes 2 -> respuesta casi inmediata al input de scroll
        },
      });

      introTl.to(
        '[data-intro-text="mobile"]',
        { opacity: 0, y: -10, duration: 1, autoRound: false },
        0,
      );
      introTl.to(
        '[data-mood-block="mobile"]',
        {
          scale: 1.4,
          filter: 'blur(6px)',
          opacity: 0.4,
          duration: 2,
          force3D: true,
          rotationZ: 0.01,
          autoRound: false,
          ease: 'power1.inOut',
        },
        0,
      );
      introTl.to(
        '[data-figure="mobile"]',
        {
          y: (i: number, el: HTMLElement) =>
            el.classList.contains('timeline-mobile__figure--1') ? -40 : 40,
          filter: 'blur(2px)',
          duration: 2,
          force3D: true,
          rotationZ: 0.01,
          autoRound: false,
          ease: 'power1.inOut',
        },
        0,
      );

      // --- Línea: ahora anima "transform" (GPU) en vez de "height" (layout) ---
      gsap.set(lineProgress, { scaleY: 0, transformOrigin: 'top center' });
      gsap.to(lineProgress, {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          id: 'timeline-mobile-line',
          trigger: '.timeline-mobile__content',
          start: 'top 85%', // antes 'top 50%' -> arranca en cuanto entra
          end: 'bottom 85%',
          scrub: 0.4,
        },
      });

      // --- Items: aparición tipo "burbuja", más cerca del borde del viewport ---
      items.forEach((item, i) => {
        const node = item.querySelector('[data-circuit-node]');
        const wrapper = item.querySelector('.timeline-item__content-wrapper');
        gsap.set(node, { scale: 0 });
        gsap.set(wrapper, { opacity: 0, y: 30, scale: 0.85 });

        gsap.timeline({
          scrollTrigger: {
            id: `timeline-mobile-item-${i}`,
            trigger: item,
            start: 'top 90%', // antes 85% -> aparece apenas asoma
            toggleActions: 'play none none reverse',
          },
        })
          .to(wrapper, {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.55,
            ease: 'power2.out',
            force3D: true,
            autoRound: false,
          })
          .to(node, { scale: 1, duration: 0.35, ease: 'back.out(2)' }, '-=0.3');
      });

      const outroTl = gsap.timeline({
        scrollTrigger: {
          id: 'timeline-mobile-outro',
          trigger: '[data-outro-spacer="mobile"]',
          start: 'top bottom',
          end: 'bottom bottom',
          scrub: 1,
        },
      });
      outroTl.to(
        '[data-intro-text="mobile"]',
        { opacity: 1, y: 0, duration: 1, autoRound: false },
        0,
      );
      outroTl.to(
        '[data-mood-block="mobile"]',
        {
          scale: 1,
          filter: 'blur(0px)',
          opacity: 1,
          duration: 2,
          force3D: true,
          rotationZ: 0.01,
          autoRound: false,
          ease: 'power1.inOut',
        },
        0,
      );
      outroTl.to(
        '[data-figure="mobile"]',
        {
          y: 0,
          filter: 'blur(0px)',
          duration: 2,
          force3D: true,
          rotationZ: 0.01,
          autoRound: false,
          ease: 'power1.inOut',
        },
        0,
      );
    });

    // =======================================================
    // CONTEXTO DESKTOP (>= 1024px)
    // =======================================================
    mm.add('(min-width: 1024px)', () => {
      const content = document.querySelector('.timeline-desktop__content');
      const itemsContainer = document.querySelector('.timeline-desktop__items');
      const items = gsap.utils.toArray<HTMLElement>(
        '[data-timeline-item="desktop"]',
      );
      const lineProgress = document.querySelector('[data-line-progress="desktop"]');

      if (prefersReducedMotion) {
        gsap.set(lineProgress, { scaleX: 1 });
        items.forEach((item) => {
          gsap.set(item.querySelector('.timeline-item__content-wrapper'), {
            opacity: 1,
            x: 0,
            scale: 1,
          });
          gsap.set(item.querySelector('[data-circuit-node]'), { scale: 1 });
        });
        return;
      }

      // --- Intro: igual que mobile, más corta y sin lag ---
      const introTl = gsap.timeline({
        scrollTrigger: {
          id: 'timeline-desktop-intro',
          trigger: '.timeline__desktop-only',
          start: 'top top',
          end: '+=70vh',
          scrub: 0.6,
        },
      });

      introTl.to(
        '[data-intro-text="desktop"]',
        { opacity: 0, y: -10, duration: 1 },
        0,
      );
      introTl.to(
        '[data-mood-block="desktop"]',
        {
          scale: 1.4,
          filter: 'blur(6px)',
          opacity: 0.4,
          duration: 2,
          force3D: true,
          rotationZ: 0.01,
          ease: 'power1.inOut',
        },
        0,
      );
      introTl.to(
        '[data-figure="desktop"]',
        {
          x: (i: number, el: HTMLElement) =>
            el.classList.contains('timeline-desktop__figure--1') ? -40 : 40,
          filter: 'blur(2px)',
          duration: 2,
          force3D: true,
          rotationZ: 0.01,
          ease: 'power1.inOut',
        },
        0,
      );

      const getScrollAmount = () =>
        (itemsContainer as HTMLElement).scrollWidth - window.innerWidth;

      const scrollTween = gsap.to(itemsContainer, {
        x: () => -getScrollAmount(),
        ease: 'none',
        scrollTrigger: {
          id: 'timeline-desktop-pin',
          trigger: content,
          pin: true,
          start: 'top top',
          end: () => `+=${getScrollAmount()}`,
          scrub: 1,
          invalidateOnRefresh: true,
        },
      });

      // --- Línea: transform (GPU) en vez de width (layout) ---
      gsap.set(lineProgress, { scaleX: 0, transformOrigin: 'left center' });
      gsap.to(lineProgress, {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: {
          id: 'timeline-desktop-line',
          trigger: content,
          start: 'top top',
          end: () => `+=${getScrollAmount()}`,
          scrub: true,
          invalidateOnRefresh: true,
        },
      });

      items.forEach((item, i) => {
        const node = item.querySelector('[data-circuit-node]');
        const wrapper = item.querySelector('.timeline-item__content-wrapper');
        gsap.set(node, { scale: 0 });
        gsap.set(wrapper, { opacity: 0, x: 60, scale: 0.85 });

        gsap.timeline({
          scrollTrigger: {
            id: `timeline-desktop-item-${i}`,
            trigger: item,
            containerAnimation: scrollTween,
            start: 'left 90%', // antes 85%
            toggleActions: 'play none none reverse',
          },
        })
          .to(wrapper, {
            opacity: 1,
            x: 0,
            scale: 1,
            duration: 0.5,
            ease: 'power2.out',
            force3D: true,
          })
          .to(node, { scale: 1, duration: 0.35, ease: 'back.out(2)' }, '-=0.3');
      });

      const outroTl = gsap.timeline({
        scrollTrigger: {
          id: 'timeline-desktop-outro',
          trigger: '[data-outro-spacer="desktop"]',
          start: 'top bottom',
          end: 'bottom bottom',
          scrub: 1,
        },
      });
      outroTl.to(
        '[data-intro-text="desktop"]',
        { opacity: 1, y: 0, duration: 1 },
        0,
      );
      outroTl.to(
        '[data-mood-block="desktop"]',
        {
          scale: 1,
          filter: 'blur(0px)',
          opacity: 1,
          duration: 2,
          force3D: true,
          rotationZ: 0.01,
          ease: 'power1.inOut',
        },
        0,
      );
      outroTl.to(
        '[data-figure="desktop"]',
        {
          x: 0,
          filter: 'blur(0px)',
          duration: 2,
          force3D: true,
          rotationZ: 0.01,
          ease: 'power1.inOut',
        },
        0,
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimelineAnimations);
  } else {
    initTimelineAnimations();
  }
  // Compatibilidad con Astro View Transitions, si tu proyecto las usa
  document.addEventListener('astro:page-load', initTimelineAnimations);
</script>
