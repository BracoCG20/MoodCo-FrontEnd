---
import './WhatsAppButton.scss';

// Utilizamos el número genérico que definimos en los datos del Footer
const phoneNumber = "51999999999"; 
const whatsappUrl = `https://wa.me/${phoneNumber}`;
---

<div class="whatsapp-container" data-wa-container>
  <!-- Burbuja de mensaje flotante -->
  <div class="whatsapp-container__tooltip" data-wa-tooltip aria-hidden="true">
    <span data-wa-message>¿Quieres más información? ¡Contáctanos!</span>
  </div>

  <!-- Botón Principal -->
  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="whatsapp-container__btn" 
    aria-label="Contactar por WhatsApp"
    data-wa-btn
  >
    <span class="whatsapp-container__icon-wrapper" data-wa-icon>
      <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M0 0h24v24H0z" fill="none" />
        <mask id="SVGlgxcXbAS" fill="#fff">
          <path fill-rule="evenodd" d="M2.184 21.331a.4.4 0 0 0 .487.494l4.607-1.204a10 10 0 0 0 4.76 1.207h.004c5.486 0 9.958-4.446 9.958-9.912a9.83 9.83 0 0 0-2.914-7.011A9.92 9.92 0 0 0 12.042 2c-5.486 0-9.958 4.446-9.958 9.911c0 1.739.458 3.447 1.33 4.954zM8.886 7.17c.183.005.386.015.579.443c.128.285.343.81.519 1.238c.137.333.249.607.277.663c.065.128.104.275.02.448l-.028.058c-.068.14-.116.24-.23.37l-.143.17c-.085.104-.17.206-.242.278c-.129.128-.262.266-.114.522s.668 1.098 1.435 1.777a6.6 6.6 0 0 0 1.903 1.2q.105.045.17.076c.257.128.41.108.558-.064c.149-.173.643-.749.817-1.005c.168-.256.34-.216.578-.128c.238.089 1.504.71 1.761.837l.143.07c.179.085.3.144.352.23c.064.109.064.62-.148 1.222c-.218.6-1.267 1.176-1.742 1.22l-.135.016c-.436.052-.988.12-2.956-.655c-2.426-.954-4.027-3.32-4.35-3.799l-.053-.076l-.005-.008c-.148-.197-1.049-1.402-1.049-2.646c0-1.19.587-1.81.854-2.092l.047-.05a.95.95 0 0 1 .687-.32c.173 0 .347 0 .495.005" clip-rule="evenodd" />
        </mask>
        <path fill="currentColor" fill-rule="evenodd" stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="M2.184 21.331a.4.4 0 0 0 .487.494l4.607-1.204a10 10 0 0 0 4.76 1.207h.004c5.486 0 9.958-4.446 9.958-9.912a9.83 9.83 0 0 0-2.914-7.011A9.92 9.92 0 0 0 12.042 2c-5.486 0-9.958 4.446-9.958 9.911c0 1.739.458 3.447 1.33 4.954zM8.886 7.17c.183.005.386.015.579.443c.128.285.343.81.519 1.238c.137.333.249.607.277.663c.065.128.104.275.02.448l-.028.058c-.068.14-.116.24-.23.37l-.143.17c-.085.104-.17.206-.242.278c-.129.128-.262.266-.114.522s.668 1.098 1.435 1.777a6.6 6.6 0 0 0 1.903 1.2q.105.045.17.076c.257.128.41.108.558-.064c.149-.173.643-.749.817-1.005c.168-.256.34-.216.578-.128c.238.089 1.504.71 1.761.837l.143.07c.179.085.3.144.352.23c.064.109.064.62-.148 1.222c-.218.6-1.267 1.176-1.742 1.22l-.135.016c-.436.052-.988.12-2.956-.655c-2.426-.954-4.027-3.32-4.35-3.799l-.053-.076l-.005-.008c-.148-.197-1.049-1.402-1.049-2.646c0-1.19.587-1.81.854-2.092l.047-.05a.95.95 0 0 1 .687-.32c.173 0 .347 0 .495.005Z" clip-rule="evenodd" mask="url(#SVGlgxcXbAS)" />
      </svg>
    </span>
  </a>
</div>

<script>
  import gsap from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const tooltip = document.querySelector('[data-wa-tooltip]');
    const messageEl = document.querySelector('[data-wa-message]');
    const icon = document.querySelector('[data-wa-icon]');
    const btn = document.querySelector('[data-wa-btn]');
    
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Mensajes con consistencia milimétrica (entre 39 y 43 caracteres aprox)
    const messages = [
      "¿Quieres más info? ¡Contáctanos!",
      "¿Tienes alguna duda? ¡Escríbenos ahora!",
      "¿Necesitas asesoría? ¡Habla con nosotros!",
      "¿Listo para arrancar? ¡Envíanos un mensaje!"
    ];

    let messageIndex = 0;
    let messageTimer: ReturnType<typeof setTimeout>;

    gsap.set(tooltip, { autoAlpha: 0, x: 15, scale: 0.9 });

    if (!prefersReducedMotion) {
      // 1. Animación de "Llamada"
      const ringTl = gsap.timeline({ repeat: -1, repeatDelay: 1.2, paused: true });
      ringTl
        .to(icon, { rotation: 10, duration: 0.08, ease: "power1.inOut" })
        .to(icon, { rotation: -10, duration: 0.08, ease: "power1.inOut" })
        .to(icon, { rotation: 10, duration: 0.08, ease: "power1.inOut" })
        .to(icon, { rotation: -10, duration: 0.08, ease: "power1.inOut" })
        .to(icon, { rotation: 0, duration: 0.08, ease: "power1.inOut" });
      
      ringTl.play();

      btn?.addEventListener('mouseenter', () => {
        ringTl.pause();
        gsap.to(icon, { rotation: 0, scale: 1.1, duration: 0.3, ease: "back.out(2)" });
      });
      
      btn?.addEventListener('mouseleave', () => {
        gsap.to(icon, { scale: 1, duration: 0.3, ease: "power2.out" });
        ringTl.play();
      });

      // 2. Animación de los Mensajes
      const showNextMessage = () => {
        if (!messageEl || !tooltip) return;

        messageEl.textContent = messages[messageIndex];
        messageIndex = (messageIndex + 1) % messages.length;

        const tooltipTl = gsap.timeline({
          onComplete: () => {
            const nextDelay = gsap.utils.random(3000, 5000);
            messageTimer = setTimeout(showNextMessage, nextDelay);
          }
        });

        tooltipTl
          .fromTo(tooltip, 
            { autoAlpha: 0, x: 15, scale: 0.9 }, 
            { autoAlpha: 1, x: 0, scale: 1, duration: 0.5, ease: "back.out(1.5)" }
          )
          .to(tooltip, { 
            autoAlpha: 0, 
            x: 10, 
            scale: 0.95, 
            duration: 0.4, 
            ease: "power2.in", 
            delay: 4 
          });
      };

      messageTimer = setTimeout(showNextMessage, 2000);
    } else {
      btn?.addEventListener('mouseenter', () => gsap.to(icon, { scale: 1.05, duration: 0.2 }));
      btn?.addEventListener('mouseleave', () => gsap.to(icon, { scale: 1, duration: 0.2 }));
    }

    document.addEventListener('astro:before-swap', () => {
      clearTimeout(messageTimer);
    });
  });
</script>