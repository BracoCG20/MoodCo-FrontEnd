---
import CustomCursor from '../components/CustomCursor/CustomCursor.astro';
import WhatsAppButton from '../components/WhatsAppButton/WhatsAppButton.astro';
import '../styles/main.scss';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Agencia creativa que potencia cada idea y cada proyecto en el entorno digital para que su marca logre mayores alcances.',
} = Astro.props;
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    />
    <meta
      name='description'
      content={description}
    />

    <!-- FIX: Tipo de archivo correcto para un .ico -->
    <link
      rel='icon'
      type='image/x-icon'
      href='/Logo_Mood.ico'
    />

    <!-- Etiquetas Open Graph (SEO / Redes Sociales) -->
    <meta
      property='og:title'
      content={title}
    />
    <meta
      property='og:description'
      content={description}
    />
    <meta
      property='og:type'
      content='website'
    />
    <meta
      property='og:url'
      content={import.meta.env.PUBLIC_SITE_URL || 'https://www.mood.com.co'}
    />
    <meta
      property='og:image'
      content='../assets/banner_Mobile.webp'
    />
    <!-- O la imagen que prefieras en public/ -->

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <WhatsAppButton />
    <CustomCursor />
    <script>
      import { initLenis, initScrollAnimations } from '../utils/animations';

      document.addEventListener('DOMContentLoaded', () => {
        initLenis();
        initScrollAnimations();
      });
    </script>
  </body>
</html>
