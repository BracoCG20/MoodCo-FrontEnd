---
import CustomCursor from '../components/CustomCursor/CustomCursor.astro';
import WhatsAppButton from '../components/WhatsAppButton/WhatsAppButton.astro';
import '../styles/main.scss';

interface Props {
  title: string;
  description?: string;
  image?: string;
  keywords?: string;
}

const {
  title,
  description = 'Agencia creativa en Colombia que potencia cada idea y cada proyecto en el entorno digital para que su marca logre mayores alcances.',
  image = '/banner_Mobile.webp',
  keywords = 'agencia colombia, diseño Web, desarrollo web, seo, data analyst, branding',
} = Astro.props;

// const lang = Astro.currentLocale || 'es';

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || 'https://mood.com.co',
);

const imageUrl = new URL(image, canonicalURL);
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='theme-color'
      content='#ffffff'
    />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    />
    <link
      rel='icon'
      type='image/x-icon'
      href='/Logo_Mood.ico'
    />
    <meta
      name='generator'
      content={Astro.generator}
    />
    <link
      rel='icon'
      href='/Logo_Mood192.png'
      type='image/png'
      sizes='192x192'
    />
    <link
      rel='apple-touch-icon'
      href='/apple-icon.png'
    />

    <!-- SEO Básico-->
    <title>{title}</title>

    <meta
      name='description'
      content={description}
    />
    <meta
      name='author'
      content='Cristian Braco'
    />
    <meta
      name='keywords'
      content={keywords}
    />
    <meta
      name='robots'
      content='index, follow'
    />
    <link
      rel='canonical'
      href={canonicalURL}
    />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta
      property='og:type'
      content='website'
    />
    <meta
      property='og:url'
      content={import.meta.env.PUBLIC_SITE_URL ||
        'https://www.mood.com.co' ||
        canonicalURL}
    />
    <meta
      property='og:title'
      content={title}
    />
    <meta
      property='og:description'
      content={description}
    />
    <meta
      property='og:image'
      content={imageUrl}
    />
    <meta
      property='og:site_name'
      content='Mood Colombia'
    />
    <!--  Se adapto el locale para SEO -->
    <!-- <meta
      property='og:locale'
      content={lang === 'es' ? 'es_ES' : 'en_US'}
    /> -->
    <!-- Twitter-->
    <meta
      property='twitter:card'
      content='summary_large_image'
    />
    <meta
      property='twitter:url'
      content={canonicalURL}
    />
    <meta
      property='twitter:title'
      content={title}
    />
    <meta
      property='twitter:description'
      content={description}
    />
    <meta
      property='twitter:image'
      content={imageUrl}
    />

    <!-- JSON-LD SEO -->
    <script type='application/ld+json'>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Mood Colombia",
        "url": "https://www.mood.com.co",
        "logo": "https://www.mood.com.co/Logo_Mood.ico",
        "description": "Agencia creativa en Colombia que potencia cada idea y cada proyecto en el entorno digital para que su marca logre mayores alcances.",
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "desguerra@mood.com.co",
          "contactType": "customer support"
        },
        "sameAs": ["https://www.linkedin.com/company/moodagenciacreativa"]
      }
    </script>
  </head>
  <body>
    <slot />
    <WhatsAppButton />
    <CustomCursor />
    <script>
      import { initLenis, initScrollAnimations } from '../utils/animations';

      document.addEventListener('DOMContentLoaded', () => {
        initLenis();
        initScrollAnimations();
      });
    </script>
  </body>
</html>
