---
import CustomCursor from '../components/CustomCursor/CustomCursor.astro';
import WhatsAppButton from '../components/WhatsAppButton/WhatsAppButton.astro';
import '../styles/main.scss';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Agencia creativa que potencia cada idea y cada proyecto en el entorno digital para que su marca logre mayores alcances.',
} = Astro.props;
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    />
    <meta
      name='description'
      content={description}
    />
    <link
      rel='icon'
      type='image/svg+xml'
      href='/Logo_Mood.ico'
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <WhatsAppButton />
    <CustomCursor />
    <script>
      import { initLenis, initScrollAnimations } from '../utils/animations';
      
      document.addEventListener('DOMContentLoaded', () => {
        initLenis();
        initScrollAnimations();
      });
    </script>
  </body>
</html>
